{
  "name": "makeup-organizer-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "npm --prefix ../client run build",
    "dev": "wrangler dev",
    "setup": "node scripts/setup.mjs",
    "migrate-data": "node scripts/migrate-data.mjs",
    "deploy": "npm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "set-password": "wrangler secret put APP_PASSWORD",
    "migrate-db": "wrangler d1 migrations apply makeup-organizer --remote",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}
