<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 允许用更新的 .NET 运行时（9/10）直接运行 -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MakeupOrganizer.Api</RootNamespace>
  </PropertyGroup>

  <!-- 数据目录不要被当成发布内容 -->
  <ItemGroup>
    <Content Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

</Project>
